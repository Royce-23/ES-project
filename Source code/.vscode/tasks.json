{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build HEX for Proteus",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Source",
                "${input:esSourceFile}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1",
                "-Clean"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "esSourceFile",
            "type": "pickString",
            "description": "Chon file C can build",
            "options": [
                "P1. 2 main.c",
                "P1.3 main.c",
                "P1.4 main.c",
                "P1.5 main code simulate button and motor.c",
                "P1.5 main code simulate lcd lm044l.c",
                "P1.6main.c",
                "P1.7main.c",
                "P1.8 main.c"
            ],
            "default": "P1. 8 main.c"
        }
    ]
}
